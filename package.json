{
  "name": "ling-keep",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local context-based language learning desktop app",
  "author": "Bern3rsH",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/Bern3rsH/LingKeep.git" },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "dictionaries": "node scripts/build-dictionaries.mjs",
    "check:web": "node scripts/check-web.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "check:package": "node scripts/check-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "1.0.11",
    "csv-parse": "6.1.0",
    "fflate": "0.8.2",
    "jsdom": "24.1.3",
    "marked": "15.0.12",
    "msedge-tts": "2.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-fsrs": "5.2.3",
    "wink-lemmatizer": "3.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.9"
  }
}
